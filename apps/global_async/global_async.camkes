import <std_connector.camkes>;
import <global-connectors.camkes>;

component Kernel {
    hardware;
}

assembly {
    composition {
        component Kernel node0;
        component Kernel node1;

    }

    configuration {
        node0.node_id = 0;
        node1.node_id = 1;


        node0.memory = [{
            "node": "/memory@40000000",
            "#size-cells": 2,
            "#address-cells": 2,
            "reg": [
                {"start": 0x40000000, "size": 0x10000000 },
            ]}];
        node0.reserved = [
                {"start": 0x50000000, "size": 0x10000000 },
            ];
        node0.shared_pool = [
            {"start": 0x60000000, "size": 0x10000000 },
        ];


        node1.memory = [{
            "node": "/memory@40000000",
            "#size-cells": 2,
            "#address-cells": 2,
            "reg": [
                {"start": 0x50000000, "size": 0x10000000 },
            ]}];
        node1.reserved = [
                {"start": 0x40000000, "size": 0x10000000 },
            ];
        node1.shared_pool = [
            {"start": 0x60000000, "size": 0x10000000 },
        ];

    }

}

component Client {
    control;
    dataport Buf data;
    consumes Notification notification_ready;
    emits Notification notification_signal;
}

component Sender {
    control;
    dataport Buf data;
    consumes Notification notification_ready;
    emits Notification notification_signal;
}

assembly {
    composition {
        component Client client;
        component Sender sender;

        connection seL4SharedData s(from client.data, to sender.data);
        connection seL4GlobalAsynch notify_ready0(from client.notification_signal, to sender.notification_ready);
        connection seL4GlobalAsynch notify_ready1(from sender.notification_signal, to client.notification_ready);
    }
    configuration {
        sender.node = "node0";
        client.node = "node1";
    }

}
